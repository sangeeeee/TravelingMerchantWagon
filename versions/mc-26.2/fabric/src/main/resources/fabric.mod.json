{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Build modular wagons, hitch draft animals and carry cargo on the road.",
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sange.tm_wagon.TravelingMerchantWagon"
    ]
  },
  "depends": {
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "geckolib": ">=${geckolib_version} <6",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  },
  "icon": "assets/tm_wagon/textures/item/wagon_icon.png"
}
